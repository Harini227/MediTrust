# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meditrust?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# File Upload (local for MVP)
UPLOAD_DIR=server/uploads
MAX_FILE_SIZE_MB=10

# Cloudinary (future, currently unused if local storage active)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_PROVIDER=local

# Azure AI Document Intelligence (future OCR - currently dummy)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
OCR_PROVIDER=dummy

# OpenAI (future AI synthesis - currently dummy)
OPENAI_API_KEY=
AI_PROVIDER=dummy

# Razorpay (future payments - currently dummy)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_PROVIDER=dummy

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
